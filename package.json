{
  "name": "midi2base64",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "lint": "npm run lint:js && npm run lint:html",
    "lint:js": "eslint \"src/**/*.ts\" \"vite.config.ts\"",
    "lint:html": "htmlhint \"index.html\" \"public/**/*.html\"",
    "format": "prettier --write \"**/*.{js,ts,vue,html,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,vue,html,css,json,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "lzma": "^2.3.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "eslint": "^9.21.0",
    "globals": "^15.14.0",
    "htmlhint": "^1.6.3",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vue-tsc": "^2.2.8"
  }
}
